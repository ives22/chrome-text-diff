{
  "manifest_version": 3,
  "name": "文本对比 TextDiff",
  "short_name": "TextDiff",
  "description": "在浏览器本地安全、清晰地比较两段文本。",
  "version": "0.1.0",
  "permissions": ["storage", "contextMenus", "clipboardWrite"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 TextDiff"
  }
}
